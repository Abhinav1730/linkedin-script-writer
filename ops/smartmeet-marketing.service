[Unit]
Description=SmartMeet marketing drafts with Codex subscription
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=2h
StartLimitBurst=3

[Service]
Type=oneshot
Restart=on-failure
RestartSec=15min
WorkingDirectory=/srv/smartmeet-marketing/current
ExecStart=/usr/bin/python3 /srv/smartmeet-marketing/current/ops/run.py --send
UMask=0077
TimeoutStartSec=12min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/smartmeet-marketing
# Reuse the existing subscription sign-in, including supported token refresh.
ReadWritePaths=/root/.codex
ProtectHome=read-only
