# Copy to /etc/smartmeet-marketing/agent.env, mode 0600. Values are JSON strings.
MARKETING_CODEX_BIN="/root/.local/bin/codex"
CODEX_HOME="/root/.codex"
HOME="/root"
MARKETING_CODEX_MODEL=""
MARKETING_CODEX_REVIEW_MODEL=""
RESEND_API_KEY=""
EMAIL_FROM="SmartMeet <marketing@your-verified-domain.example>"
DEMO_EMAIL="marketing-demo@smartmeet.invalid"
DEMO_PASSWORD=""
AGENT_STATE_DIR="/var/lib/smartmeet-marketing"
